# Web3Forms — https://web3forms.com adresinden ücretsiz bir "Access Key" al,
# frhttaspinar@gmail.com ile doğrula, aşağıya yapıştır. Backend/veritabanı
# gerekmez; form gönderimleri doğrudan bu maile düşer.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key-here

# Site adresi — OPSİYONEL.
# Üretim domaini kodda varsayılan olarak tanımlı (https://www.dokuyazilim.com),
# bu yüzden production ortamında bu değişkeni tanımlamaya gerek yok.
# Yalnızca preview/staging gibi farklı bir alan adı altında yayına alırken,
# canonical ve sitemap adreslerinin o alan adını göstermesi için tanımla.
# Sunucu tarafında okunur; NEXT_PUBLIC_ öneki gerekmez.
SITE_URL=https://www.dokuyazilim.com
